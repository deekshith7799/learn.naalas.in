# Copy to .env and fill in. Never commit .env.
# The server refuses to start while any "change-this..." placeholder below is left in place.
# Local test on your own machine: DOMAIN=http://localhost   (plain HTTP, no certificate warning)
# On the server: your real domain, e.g. learn.example.com
DOMAIN=localhost
POSTGRES_PASSWORD=change-this-db-password
# Generate with: openssl rand -hex 32   (at least 16 characters)
JWT_SECRET=change-this-long-random-string
# First admin account (created only when the users table is empty). Password: at least 8 characters.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-admin-password
# Practice lab: admin password of the three sandbox database servers. Letters and digits only.
# Generate with: openssl rand -hex 16
LAB_ADMIN_PASSWORD=change-this-lab-password
# Team sign-up: anyone who knows this code can create their own learner account from the login page.
# At least 6 characters. Share it only with your team. Sign-up never creates admins.
# Leave it empty to turn sign-up off (then only an admin can add people). The sign-up link only shows when a code is set.
SIGNUP_CODE=change-this-team-code

# ---- Docker Hub + Kubernetes only (docker compose ignores these) ----
# Your Docker Hub username: images are <user>/dba-academy-server and <user>/dba-academy-web
DOCKERHUB_USER=
# Image tag to deploy (deploy/push-images.sh prints it). "latest" always works.
IMAGE_TAG=latest
# Email for Let's Encrypt certificate notices (HTTPS)
ACME_EMAIL=
# Only if your Docker Hub repositories are private: a read-only access token
DOCKERHUB_TOKEN=

# ---- Trial mode: no login ----
# OPEN_ACCESS=true removes the login step: every visitor gets their own throw-away guest account
# (learner only, never admin) with a private practice sandbox. Admins still sign in at /login.
# Use it for a short trial, then empty it again (OPEN_ACCESS=) and restart to bring the login back.
OPEN_ACCESS=
